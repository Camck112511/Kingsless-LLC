# DEV ONLY. Next.js loads this file only for `next dev`, never for `next build` / production.
# It exists so anyone (including Grok's preview sandbox) can log in to /admin locally.
# Production refuses these values (see src/server/auth.ts), so they can never unlock a deployed site.
ADMIN_PASSWORD=dev-only-admin-password
AUTH_SECRET=dev-only-auth-secret-not-for-production-0123456789abcdef
