# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# Do NOT commit real values. See README.md for what each one does.

# --- Required for the admin area. If either is missing/too short the admin is DISABLED (fails closed). ---
# At least 12 characters. This is the only password to the admin area.
ADMIN_PASSWORD=
# At least 32 random characters. Used to sign the login cookie. Generate with:  openssl rand -base64 48
AUTH_SECRET=

# --- Optional: live federal discovery (free key from https://sam.gov -> your profile -> Public API Key). ---
SAM_GOV_API_KEY=

# --- Optional: AI reading of pasted solicitation text. Without it the built-in rule-based reader is used. ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Optional: shows on the public Contact page (e.g. hello@yourdomain.com). ---
NEXT_PUBLIC_CONTACT_EMAIL=
